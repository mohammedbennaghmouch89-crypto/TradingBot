//@version=6
// VP + ICT Strategy V1 - STRATEGY version (TradingView Strategy Tester). Use on MNQ1!.
// Paste-hardened: every statement on one line so mobile copy-paste cannot break it.
strategy("VP+ICT V1 Strategy", shorttitle="VP+ICT V1 STR", overlay=true, initial_capital=25000, currency=currency.USD, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, process_orders_on_close=true, commission_type=strategy.commission.cash_per_order, commission_value=0.5, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ---- Inputs ----
gVP = "Volume Profile (3m context)"
vpSession = input.session("0930-1600", "Session window", group=gVP)
vpTz = input.string("America/New_York", "Session timezone", group=gVP)
vpRows = input.int(24, "Profile rows", minval=8, maxval=100, group=gVP)
vaPercent = input.float(0.70, "Value Area %", minval=0.5, maxval=0.95, step=0.01, group=gVP)
gSet = "Setup"
useVAedges = input.bool(true, "Setup at VAH / VAL", group=gSet)
usePOC = input.bool(true, "Setup at POC", group=gSet)
useNPOC = input.bool(true, "Setup at naked POC", group=gSet)
tolAtrMult = input.float(0.75, "Proximity tol (x ATR)", minval=0.05, maxval=2.0, step=0.05, group=gSet)
setupBars = input.int(120, "Setup active for N bars", minval=3, maxval=400, group=gSet)
minPocEdgeAtr = input.float(1.25, "Min POC-to-edge (x ATR)", minval=0.0, maxval=5.0, step=0.25, group=gSet)
gICT = "Entry (ICT)"
pivotLen = input.int(4, "Swing lookback", minval=2, maxval=25, group=gICT)
useCloseBreak = input.bool(true, "Break needs body CLOSE", group=gICT)
oteMax = input.float(0.5, "Max retrace into FVG", minval=0.1, maxval=1.0, step=0.05, group=gICT)
stopBuffAtr = input.float(0.1, "Stop buffer (x ATR)", minval=0.0, maxval=1.0, step=0.05, group=gICT)
sweepWindow = input.int(60, "Bars sweep->MSS+FVG", minval=1, maxval=200, group=gICT)
entryWindow = input.int(60, "Bars FVG->retrace", minval=1, maxval=200, group=gICT)
gFilt = "Selection filters"
useVwapPD = input.bool(true, "VWAP premium/discount gate", group=gFilt)
useKillzone = input.bool(false, "Killzone time filter", group=gFilt)
kzStart = input.session("0930-1130", "Killzone window (NY)", group=gFilt)
targetMode = input.string("POC", "Exit target", options=["POC","Opposite VA edge"], group=gFilt)
breakevenAt = input.float(0.5, "Breakeven at (frac of target)", minval=0.0, maxval=1.0, step=0.05, group=gFilt)
flatEOD = input.bool(true, "Flatten at session close", group=gFilt)
gViz = "Visuals"
showFVG = input.bool(true, "Draw entry FVG box", group=gViz)
colPOC = input.color(color.black, "POC", group=gViz)
colVAH = input.color(color.green, "VAH", group=gViz)
colVAL = input.color(color.red, "VAL", group=gViz)
colLong = input.color(color.teal, "Long", group=gViz)
colShort = input.color(color.red, "Short", group=gViz)

atr = ta.atr(14)
tol = atr * tolAtrMult

// ---- Session-anchored profile ----
var float[] sH = array.new_float()
var float[] sL = array.new_float()
var float[] sV = array.new_float()
inSession = not na(time(timeframe.period, vpSession, vpTz))
newSession = inSession and not inSession[1]
if newSession
    array.clear(sH)
    array.clear(sL)
    array.clear(sV)
var float vwapPV = na
var float vwapVol = na
if newSession
    vwapPV := hlc3 * volume
    vwapVol := volume
else
    vwapPV := nz(vwapPV) + hlc3 * volume
    vwapVol := nz(vwapVol) + volume
sessionVwap = vwapVol > 0 ? vwapPV / vwapVol : na
inKillzone = not na(time(timeframe.period, kzStart, vpTz))
if inSession and barstate.isconfirmed
    array.push(sH, high)
    array.push(sL, low)
    array.push(sV, volume)

f_valueArea(float[] bins, int poc, float target) =>
    total = 0.0
    for i = 0 to array.size(bins) - 1
        total += array.get(bins, i)
    acc = array.get(bins, poc)
    up = poc
    dn = poc
    n = array.size(bins)
    tgt = total * target
    brk = false
    while acc < tgt and not brk
        a1 = up + 1 <= n - 1 ? array.get(bins, up + 1) : 0.0
        a2 = up + 2 <= n - 1 ? array.get(bins, up + 2) : 0.0
        b1 = dn - 1 >= 0 ? array.get(bins, dn - 1) : 0.0
        b2 = dn - 2 >= 0 ? array.get(bins, dn - 2) : 0.0
        aboveSum = a1 + a2
        belowSum = b1 + b2
        if aboveSum == 0 and belowSum == 0
            brk := true
        else if aboveSum >= belowSum
            acc += aboveSum
            up += 2
        else
            acc += belowSum
            dn -= 2
    [math.min(dn, n - 1) < 0 ? 0 : dn, math.min(up, n - 1)]

f_buildProfile() =>
    n = math.min(array.size(sH), math.min(array.size(sL), array.size(sV)))
    float pocP = na
    float vahP = na
    float valP = na
    float botP = na
    float rowH = na
    float[] bins = array.new_float(vpRows, 0.0)
    if n > 0
        hi = array.get(sH, 0)
        lo = array.get(sL, 0)
        if n > 1
            for i = 1 to n - 1
                hi := math.max(hi, array.get(sH, i))
                lo := math.min(lo, array.get(sL, i))
        rng = hi - lo
        if rng > 0
            rh = rng / vpRows
            for i = 0 to n - 1
                bl = array.get(sL, i)
                bh = array.get(sH, i)
                bv = array.get(sV, i)
                loIdx = math.max(0, math.min(vpRows - 1, int((bl - lo) / rh)))
                hiIdx = math.max(0, math.min(vpRows - 1, int((bh - lo) / rh)))
                span = hiIdx - loIdx + 1
                per = bv / span
                for r = loIdx to hiIdx
                    array.set(bins, r, array.get(bins, r) + per)
            poc = 0
            for r = 1 to vpRows - 1
                if array.get(bins, r) > array.get(bins, poc)
                    poc := r
            [valIdx, vahIdx] = f_valueArea(bins, poc, vaPercent)
            pocP := lo + (poc + 0.5) * rh
            vahP := lo + (vahIdx + 0.5) * rh
            valP := lo + (valIdx + 0.5) * rh
            botP := lo
            rowH := rh
    [pocP, vahP, valP, bins, botP, rowH]

[poc, vah, val, bins, profBot, profRowH] = f_buildProfile()

// ---- Naked POC ----
var float nakedPoc = na
var bool nakedActive = false
var float thisSessionPoc = na
if not na(poc)
    thisSessionPoc := poc
if newSession and not na(thisSessionPoc[1])
    nakedPoc := thisSessionPoc[1]
    nakedActive := true
if nakedActive and not na(nakedPoc) and high >= nakedPoc and low <= nakedPoc
    nakedActive := false

// ---- Setup detection ----
f_near(level) => not na(level) and math.abs(close - level) <= tol
minRoom = minPocEdgeAtr * atr
roomVAL = not na(poc) and not na(val) and math.abs(poc - val) >= minRoom
roomVAH = not na(poc) and not na(vah) and math.abs(vah - poc) >= minRoom
var int setupBias = 0
var string setupName = ""
var int setupAge = 0
newSetup = false
if useVAedges and f_near(val) and close >= val and roomVAL
    setupBias := 1
    setupName := "VAL"
    setupAge := 0
    newSetup := true
else if useVAedges and f_near(vah) and close <= vah and roomVAH
    setupBias := -1
    setupName := "VAH"
    setupAge := 0
    newSetup := true
else if useNPOC and nakedActive and f_near(nakedPoc)
    setupBias := close < nakedPoc ? 1 : -1
    setupName := "nPOC"
    setupAge := 0
    newSetup := true
else if usePOC and f_near(poc)
    setupName := "POC"
if setupBias != 0
    setupAge += 1
    if setupAge > setupBars
        setupBias := 0
setupActive = setupBias != 0

// ---- Entry detection (ICT) ----
ph = ta.pivothigh(pivotLen, pivotLen)
pl = ta.pivotlow(pivotLen, pivotLen)
var float lastSwingHigh = na
var float lastSwingLow = na
if not na(ph)
    lastSwingHigh := ph
if not na(pl)
    lastSwingLow := pl
sweptLow = not na(lastSwingLow) and low < lastSwingLow and close > lastSwingLow
sweptHigh = not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh
bullFvg = not na(high[2]) and low > high[2]
bearFvg = not na(low[2]) and high < low[2]
fvgTopBull = low
fvgBotBull = high[2]
fvgTopBear = low[2]
fvgBotBear = high
breakUp = not na(lastSwingHigh) and (useCloseBreak ? close > lastSwingHigh : high > lastSwingHigh)
breakDown = not na(lastSwingLow) and (useCloseBreak ? close < lastSwingLow : low < lastSwingLow)
var int stage = 0
var int stageDir = 0
var int stageAge = 0
var float fvgTop = na
var float fvgBot = na
var float sweptExt = na
var box fvgBox = na
longEntry = false
shortEntry = false
var float entryPrice = na
var float stopPrice = na
var float tp1Price = na
var float tp2Price = na
stageAge += 1
if stage == 0 and setupActive
    if setupBias == 1 and sweptLow
        stage := 1
        stageDir := 1
        stageAge := 0
        sweptExt := low
    else if setupBias == -1 and sweptHigh
        stage := 1
        stageDir := -1
        stageAge := 0
        sweptExt := high
else if stage == 1
    if stageAge > sweepWindow or stageDir != setupBias
        stage := 0
    else if stageDir == 1 and breakUp and bullFvg
        stage := 2
        stageAge := 0
        fvgTop := fvgTopBull
        fvgBot := fvgBotBull
        if showFVG
            fvgBox := box.new(bar_index, fvgTop, bar_index + 5, fvgBot, border_color=colLong, bgcolor=color.new(colLong, 85))
    else if stageDir == -1 and breakDown and bearFvg
        stage := 2
        stageAge := 0
        fvgTop := fvgTopBear
        fvgBot := fvgBotBear
        if showFVG
            fvgBox := box.new(bar_index, fvgTop, bar_index + 5, fvgBot, border_color=colShort, bgcolor=color.new(colShort, 85))
else if stage == 2
    if stageAge > entryWindow
        if not na(fvgBox)
            box.delete(fvgBox)
            fvgBox := na
        stage := 0
    else if stageDir == 1
        fvgMid = fvgBot + (fvgTop - fvgBot) * oteMax
        kzOk = not useKillzone or inKillzone
        pdOk = not useVwapPD or na(sessionVwap) or fvgMid <= sessionVwap
        if low <= fvgMid
            if kzOk and pdOk
                longEntry := true
                entryPrice := fvgMid
                stopPrice := sweptExt - atr * stopBuffAtr
                tp1Price := na(poc) ? vah : poc
                tp2Price := vah
                if not na(fvgBox)
                    box.set_right(fvgBox, bar_index)
                    fvgBox := na
            else if not na(fvgBox)
                box.delete(fvgBox)
                fvgBox := na
            stage := 0
        else if not na(sweptExt) and close < sweptExt
            if not na(fvgBox)
                box.delete(fvgBox)
                fvgBox := na
            stage := 0
    else if stageDir == -1
        fvgMid = fvgTop - (fvgTop - fvgBot) * oteMax
        kzOk = not useKillzone or inKillzone
        pdOk = not useVwapPD or na(sessionVwap) or fvgMid >= sessionVwap
        if high >= fvgMid
            if kzOk and pdOk
                shortEntry := true
                entryPrice := fvgMid
                stopPrice := sweptExt + atr * stopBuffAtr
                tp1Price := na(poc) ? val : poc
                tp2Price := val
                if not na(fvgBox)
                    box.set_right(fvgBox, bar_index)
                    fvgBox := na
            else if not na(fvgBox)
                box.delete(fvgBox)
                fvgBox := na
            stage := 0
        else if not na(sweptExt) and close > sweptExt
            if not na(fvgBox)
                box.delete(fvgBox)
                fvgBox := na
            stage := 0
if not setupActive
    if not na(fvgBox)
        box.delete(fvgBox)
        fvgBox := na
    stage := 0
primaryTarget = targetMode == "POC" ? tp1Price : tp2Price
beLevel = entryPrice + (primaryTarget - entryPrice) * breakevenAt

// ---- Strategy orders ----
var float sStop = na
var float sTarget = na
var float sBE = na
var bool sBEon = false
if strategy.position_size == 0 and inSession
    if longEntry and not na(stopPrice) and not na(primaryTarget)
        strategy.entry("Long", strategy.long)
        sStop := stopPrice
        sTarget := primaryTarget
        sBE := beLevel
        sBEon := false
    else if shortEntry and not na(stopPrice) and not na(primaryTarget)
        strategy.entry("Short", strategy.short)
        sStop := stopPrice
        sTarget := primaryTarget
        sBE := beLevel
        sBEon := false
if flatEOD and not inSession and strategy.position_size != 0
    strategy.close_all(comment="EOD")
else
    if strategy.position_size > 0
        if breakevenAt > 0 and not sBEon and high >= sBE
            sStop := strategy.position_avg_price
            sBEon := true
        strategy.exit("ExitL", from_entry="Long", stop=sStop, limit=sTarget)
    else if strategy.position_size < 0
        if breakevenAt > 0 and not sBEon and low <= sBE
            sStop := strategy.position_avg_price
            sBEon := true
        strategy.exit("ExitS", from_entry="Short", stop=sStop, limit=sTarget)

// ---- Level lines (on last bar) ----
var line pocLine = na
var line vahLine = na
var line valLine = na
var line npocLine = na
if barstate.islast
    if not na(poc)
        pocLine := na(pocLine) ? line.new(bar_index - 1, poc, bar_index, poc, color=colPOC, width=2, extend=extend.right) : pocLine
        line.set_xy1(pocLine, bar_index - 1, poc)
        line.set_xy2(pocLine, bar_index, poc)
    if not na(vah)
        vahLine := na(vahLine) ? line.new(bar_index - 1, vah, bar_index, vah, color=colVAH, width=2, extend=extend.right) : vahLine
        line.set_xy1(vahLine, bar_index - 1, vah)
        line.set_xy2(vahLine, bar_index, vah)
    if not na(val)
        valLine := na(valLine) ? line.new(bar_index - 1, val, bar_index, val, color=colVAL, width=2, extend=extend.right) : valLine
        line.set_xy1(valLine, bar_index - 1, val)
        line.set_xy2(valLine, bar_index, val)
    if useNPOC and nakedActive and not na(nakedPoc)
        npocLine := na(npocLine) ? line.new(bar_index - 1, nakedPoc, bar_index, nakedPoc, color=color.new(colPOC, 30), style=line.style_dashed, extend=extend.right) : npocLine
        line.set_xy1(npocLine, bar_index - 1, nakedPoc)
        line.set_xy2(npocLine, bar_index, nakedPoc)

plot(useVwapPD ? sessionVwap : na, title="Session VWAP", color=color.new(color.purple, 0), linewidth=1)
plotshape(newSetup and setupBias == 1, title="Long setup", style=shape.diamond, location=location.belowbar, color=colLong, size=size.tiny)
plotshape(newSetup and setupBias == -1, title="Short setup", style=shape.diamond, location=location.abovebar, color=colShort, size=size.tiny)
alertcondition(newSetup, title="VP setup formed", message="VP+ICT V1: SETUP formed")
alertcondition(longEntry, title="Long entry", message="VP+ICT V1: LONG entry")
alertcondition(shortEntry, title="Short entry", message="VP+ICT V1: SHORT entry")
