//@version=6
// =============================================================================
//  VP + ICT Strategy V1   —   TradingBot Phase 1 indicator
// -----------------------------------------------------------------------------
//  WHAT IT DOES
//  ------------
//  Implements the project's "Strategy V1" in a single indicator that you apply
//  to BOTH the context chart (3-minute, default) and the 1-minute chart of the
//  same symbol:
//
//    1. CONTEXT / SETUP  (Volume Profile, read on the 3-minute chart)
//       Builds a session-anchored Volume Profile (POC, Value Area VAH/VAL,
//       HVN/LVN, prior-session "naked" POC) and flags a SETUP when price
//       reaches a key value-area edge with a directional bias.
//
//    2. ENTRY  (ICT, executed on the 1-minute chart)
//       While a SETUP bias is active and price sits at the 3m level, it runs the
//       ICT entry backbone on the 1m as an ORDERED SEQUENCE: liquidity sweep ->
//       (within sweepWindow) market-structure shift with displacement (FVG) ->
//       (within entryWindow) entry on the retrace into the FVG. It prints an
//       ENTRY arrow with a stop and two targets.
//
//  The Volume Profile is anchored to a *session window* (RTH by default, New York
//  time), so the SAME price action is binned on the 3m and the 1m chart and the
//  POC/VAH/VAL line up across the two timeframes — no cross-timeframe
//  `request.security` needed for the levels. You literally apply this one script
//  to both charts and get the two-step workflow.
//
//  IMPORTANT — this is a DECISION-SUPPORT indicator, not an auto-trader. It marks
//  setups/entries and fires alerts; the bot (Phase 2) is what would act on them.
//
//  CONVENTIONS (see docs/INDICATOR.md and the volume-profile / ict skills):
//   - Volume-at-price is APPROXIMATED from OHLCV by distributing each bar's
//     volume uniformly across its high-low range (no tick data on the chart).
//   - Value Area uses the canonical 70% / two-rows-per-side / tie-break-upper algo.
//   - ICT: structure break = body CLOSE beyond a swing; sweep = WICK beyond that
//     closes back inside. Pivots confirm `len` bars later (documented repaint lag).
//   - All session/time logic is in "America/New_York"; never a hardcoded offset.
//
//  Every threshold below is an input so it can be tuned and (Phase 2) backtested.
// =============================================================================

indicator("VP + ICT Strategy V1", shorttitle="VP+ICT V1", overlay=true,
     max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ============================ INPUTS =========================================

// ---- Volume Profile ----
grpVP      = "Volume Profile (3m context)"
vpSession  = input.session("0930-1600", "Session window",            group=grpVP,
     tooltip="The profile is built only from bars inside this window (RTH default).")
vpTz       = input.string("America/New_York", "Session timezone",    group=grpVP)
vpRows     = input.int(24, "Profile rows", minval=8, maxval=100,     group=grpVP,
     tooltip="Row count = bin height. The single most outcome-changing VP setting.")
vaPercent  = input.float(0.70, "Value Area %", minval=0.5, maxval=0.95, step=0.01, group=grpVP,
     tooltip="0.70 convention (~1 sigma). 0.68 = true 1 sigma; 0.80 for the 80% rule.")
nodeWin    = input.int(2, "HVN/LVN window (rows each side)", minval=1, maxval=5, group=grpVP)
lvnFactor  = input.float(0.6, "LVN max vs neighbours", minval=0.1, maxval=1.0, step=0.05, group=grpVP,
     tooltip="A row is an LVN if it is a local valley AND below this fraction of its neighbours' avg.")
hvnFactor  = input.float(1.4, "HVN min vs neighbours", minval=1.0, maxval=3.0, step=0.05, group=grpVP)

// ---- Setup (which levels, how close) ----
grpSet     = "Setup (Volume Profile)"
useVAedges = input.bool(true,  "Setup at VAH / VAL", group=grpSet)
usePOC     = input.bool(true,  "Setup at POC",       group=grpSet)
useNPOC    = input.bool(true,  "Setup at naked POC", group=grpSet)
tolAtrMult = input.float(0.75, "Proximity tolerance (x ATR)", minval=0.05, maxval=2.0, step=0.05, group=grpSet,
     tooltip="How close price must get to a level to arm a setup. ATR-based for cross-instrument robustness.")
setupBars  = input.int(120, "Setup stays active for N bars", minval=3, maxval=400, group=grpSet,
     tooltip="After a level is touched, the ICT entry sequence stays valid this many bars.")
minPocEdgeAtr = input.float(1.25, "Min POC-to-edge distance (x ATR)", minval=0.0, maxval=5.0, step=0.25, group=grpSet,
     tooltip="Skip a VAH/VAL setup when the value area is compressed (POC too close to that edge); the edge->POC target would be tiny. 0 disables.")

// ---- Entry (ICT) ----
grpICT     = "Entry (ICT, 1m)"
pivotLen   = input.int(4, "Swing lookback (internal pivots)", minval=2, maxval=25, group=grpICT,
     tooltip="ta.pivothigh/low length. Pivots confirm this many bars later (repaint lag).")
useCloseBreak = input.bool(true, "Structure break needs body CLOSE", group=grpICT,
     tooltip="ON = ICT-standard close beyond swing. OFF = wick allowed (LuxAlgo-style).")
oteMax     = input.float(0.5, "Max retrace into FVG for entry (0..1)", minval=0.1, maxval=1.0, step=0.05, group=grpICT,
     tooltip="Enter only when price retraces at least to this fraction of the FVG (0.5 = consequent encroachment).")
stopBuffAtr = input.float(0.1, "Stop buffer beyond swept extreme (x ATR)", minval=0.0, maxval=1.0, step=0.05, group=grpICT)
sweepWindow = input.int(60, "Bars after sweep to find MSS+FVG", minval=1, maxval=200, group=grpICT,
     tooltip="The sequence sweep -> MSS+FVG must complete within this many bars.")
entryWindow = input.int(60, "Bars after FVG to find retrace entry", minval=1, maxval=200, group=grpICT,
     tooltip="After the FVG arms, the retrace entry must occur within this many bars.")

// ---- Trade-selection filters (ICT/VP confluence) ----
grpFilt    = "Selection filters"
useVwapPD  = input.bool(true, "VWAP premium/discount gate", group=grpFilt,
     tooltip="Longs only at/below session VWAP (discount); shorts only at/above (premium). VWAP = equilibrium.")
useKillzone = input.bool(false, "Killzone time filter (NY AM)", group=grpFilt,
     tooltip="Only enter inside the NY-AM window. Lifts win rate but is selective (few trades). Off by default.")
kzStart    = input.session("0930-1130", "Killzone window (NY)", group=grpFilt)
targetMode = input.string("POC", "Exit target", options=["POC","Opposite VA edge"], group=grpFilt,
     tooltip="POC = nearer, higher win rate. Opposite edge = TP2, bigger winners.")
breakevenAt = input.float(0.5, "Move SL to breakeven at (frac of target)", minval=0.0, maxval=1.0, step=0.05, group=grpFilt,
     tooltip="When price reaches this fraction of entry->target, move stop to entry. Applied live by the bot; shown as 'BE @' on the entry label. 0 disables.")

// ---- Trade result simulation (1 micro contract) ----
grpPnl     = "Trade result ($, 1 micro)"
showResult = input.bool(true, "Mark exit candle + show P&L", group=grpPnl,
     tooltip="Tracks each entry to its SL/TP, colours the exit candle (green win / red loss / gray breakeven) and prints the $ result for 1 contract.")
pointValue = input.float(2.0, "Point value ($/point)", minval=0.0, step=0.5, group=grpPnl,
     tooltip="MNQ (Micro Nasdaq) = $2.00 per index point. MES=$5, MNQ=$2, NQ=$20.")

// ---- Visuals ----
grpViz     = "Visuals"
showHisto  = input.bool(true,  "Draw profile histogram", group=grpViz)
showNodes  = input.bool(true,  "Mark HVN / LVN",         group=grpViz)
showFVG    = input.bool(true,  "Draw entry FVG box",     group=grpViz)
lblSizeOpt = input.string("normal", "Entry label size", options=["small","normal","large","huge"], group=grpViz)
lblOffset  = input.int(8, "Entry label offset (bars right)", minval=0, maxval=50, group=grpViz,
     tooltip="Pushes the entry label to the right of the bar so it does not overlap the FVG box and the ENTRY arrow.")
colPOC     = input.color(color.new(color.orange, 0),  "POC",  group=grpViz)
colVA      = input.color(color.new(color.blue,  0),   "VAH/VAL", group=grpViz)
colHist    = input.color(color.new(color.gray,  70),  "Histogram", group=grpViz)
colLong    = input.color(color.new(color.teal,  0),   "Long",  group=grpViz)
colShort   = input.color(color.new(color.red,   0),   "Short", group=grpViz)
lblSize    = lblSizeOpt == "huge" ? size.huge : lblSizeOpt == "large" ? size.large : lblSizeOpt == "small" ? size.small : size.normal

atr = ta.atr(14)
tol = atr * tolAtrMult

// ====================== SESSION-ANCHORED PROFILE =============================
// We keep this session's bar highs/lows/volumes in arrays and rebuild the
// histogram each confirmed bar over [sessionLow, sessionHigh]. The session is
// small (RTH 3m ~ 130 bars, 1m ~ 390 bars), so the O(bars x rows) rebuild is cheap.

var float[] sH = array.new_float()
var float[] sL = array.new_float()
var float[] sV = array.new_float()

inSession = not na(time(timeframe.period, vpSession, vpTz))
newSession = inSession and not inSession[1]

if newSession
    array.clear(sH)
    array.clear(sL)
    array.clear(sV)

// Session VWAP (equilibrium / fair value) for the premium-discount gate, and the
// killzone flag for the time filter. VWAP resets each session window.
var float vwapPV  = na
var float vwapVol = na
if newSession
    vwapPV  := hlc3 * volume
    vwapVol := volume
else
    vwapPV  := nz(vwapPV) + hlc3 * volume
    vwapVol := nz(vwapVol) + volume
sessionVwap = vwapVol > 0 ? vwapPV / vwapVol : na
inKillzone = not na(time(timeframe.period, kzStart, vpTz))

// Accumulate the just-closed bar's data while inside the session.
if inSession and barstate.isconfirmed
    array.push(sH, high)
    array.push(sL, low)
    array.push(sV, volume)

// ---- Value Area: canonical 70% / two-rows-per-side / tie-break-upper --------
f_valueArea(float[] bins, int poc, float target) =>
    total = 0.0
    for i = 0 to array.size(bins) - 1
        total += array.get(bins, i)
    acc   = array.get(bins, poc)
    up    = poc
    dn    = poc
    n     = array.size(bins)
    tgt   = total * target
    brk   = false
    while acc < tgt and not brk
        a1 = up + 1 <= n - 1 ? array.get(bins, up + 1) : 0.0
        a2 = up + 2 <= n - 1 ? array.get(bins, up + 2) : 0.0
        b1 = dn - 1 >= 0      ? array.get(bins, dn - 1) : 0.0
        b2 = dn - 2 >= 0      ? array.get(bins, dn - 2) : 0.0
        aboveSum = a1 + a2
        belowSum = b1 + b2
        if aboveSum == 0 and belowSum == 0
            brk := true
        else if aboveSum >= belowSum    // tie -> expand UP (upper-row convention)
            acc += aboveSum
            up  += 2
        else
            acc += belowSum
            dn  -= 2
    [math.min(dn, n - 1) < 0 ? 0 : dn, math.min(up, n - 1)]

// ---- Build profile from the session arrays ----------------------------------
// Returns POC/VAH/VAL prices, the bins array, the bottom price and row height.
f_buildProfile() =>
    // Use the smallest of the three arrays so a read can never go out of bounds.
    n = math.min(array.size(sH), math.min(array.size(sL), array.size(sV)))
    float pocP = na
    float vahP = na
    float valP = na
    float botP = na
    float rowH = na
    float[] bins = array.new_float(vpRows, 0.0)
    if n > 0
        hi = array.get(sH, 0)
        lo = array.get(sL, 0)
        // Guard: Pine `for 1 to n-1` counts DOWN when n==1, so only loop n>1.
        if n > 1
            for i = 1 to n - 1
                hi := math.max(hi, array.get(sH, i))
                lo := math.min(lo, array.get(sL, i))
        rng = hi - lo
        if rng > 0
            rh = rng / vpRows
            // distribute each bar's volume uniformly across the rows it spans
            for i = 0 to n - 1
                bl = array.get(sL, i)
                bh = array.get(sH, i)
                bv = array.get(sV, i)
                loIdx = math.max(0, math.min(vpRows - 1, int((bl - lo) / rh)))
                hiIdx = math.max(0, math.min(vpRows - 1, int((bh - lo) / rh)))
                span  = hiIdx - loIdx + 1
                per   = bv / span
                for r = loIdx to hiIdx
                    array.set(bins, r, array.get(bins, r) + per)
            // POC = highest-volume row
            poc = 0
            for r = 1 to vpRows - 1
                if array.get(bins, r) > array.get(bins, poc)
                    poc := r
            [valIdx, vahIdx] = f_valueArea(bins, poc, vaPercent)
            pocP := lo + (poc + 0.5) * rh
            vahP := lo + (vahIdx + 0.5) * rh
            valP := lo + (valIdx + 0.5) * rh
            botP := lo
            rowH := rh
    [pocP, vahP, valP, bins, botP, rowH]

[poc, vah, val, bins, profBot, profRowH] = f_buildProfile()

// ====================== NAKED POC (prior session) ===========================
// Carry the prior session's POC forward until price trades through it.
var float nakedPoc      = na
var bool  nakedActive   = false
var float thisSessionPoc = na

if not na(poc)
    thisSessionPoc := poc

// At a new session, promote last session's POC to the naked POC.
if newSession and not na(thisSessionPoc[1])
    nakedPoc    := thisSessionPoc[1]
    nakedActive := true

// A naked POC is "filled" once a bar trades through it.
if nakedActive and not na(nakedPoc) and high >= nakedPoc and low <= nakedPoc
    nakedActive := false

// ====================== SETUP DETECTION (Volume Profile) =====================
// A SETUP arms when price reaches a key level within `tol`, defining a bias.
//  - At VAL (lower value edge)  -> LONG  fade bias  (rejection back toward POC)
//  - At VAH (upper value edge)  -> SHORT fade bias
//  - At naked POC               -> fade toward it / through it (magnet)
//  - At POC                     -> context only (no edge bias in V1)
f_near(level) => not na(level) and math.abs(close - level) <= tol

// Compressed-value-area filter: require room from POC to the edge being traded.
minRoom = minPocEdgeAtr * atr
roomVAL = not na(poc) and not na(val) and math.abs(poc - val) >= minRoom
roomVAH = not na(poc) and not na(vah) and math.abs(vah - poc) >= minRoom

var int   setupBias  = 0      // +1 long, -1 short, 0 none
var float setupLevel = na
var string setupName = ""
var int   setupAge   = 0

newSetup = false
if useVAedges and f_near(val) and close >= val and roomVAL
    setupBias  := 1
    setupLevel := val
    setupName  := "VAL"
    setupAge   := 0
    newSetup   := true
else if useVAedges and f_near(vah) and close <= vah and roomVAH
    setupBias  := -1
    setupLevel := vah
    setupName  := "VAH"
    setupAge   := 0
    newSetup   := true
else if useNPOC and nakedActive and f_near(nakedPoc)
    setupBias  := close < nakedPoc ? 1 : -1
    setupLevel := nakedPoc
    setupName  := "nPOC"
    setupAge   := 0
    newSetup   := true
else if usePOC and f_near(poc)
    setupName  := "POC"   // context tag only; bias stays as-is

// Age out the setup window.
if setupBias != 0
    setupAge += 1
    if setupAge > setupBars
        setupBias  := 0
        setupLevel := na
setupActive = setupBias != 0

// ====================== ENTRY DETECTION (ICT, 1m) ============================
// Backbone: liquidity sweep -> MSS + displacement (FVG) -> retrace-into-FVG entry,
// in the SETUP's bias direction. Pivots confirm `pivotLen` bars later.

ph = ta.pivothigh(pivotLen, pivotLen)
pl = ta.pivotlow(pivotLen, pivotLen)
var float lastSwingHigh = na
var float lastSwingLow  = na
if not na(ph)
    lastSwingHigh := ph
if not na(pl)
    lastSwingLow  := pl

// 1) Liquidity sweep: wick beyond the swing that closes back inside.
sweptLow  = not na(lastSwingLow)  and low  < lastSwingLow  and close > lastSwingLow
sweptHigh = not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh

// 2) Displacement that leaves a 3-candle FVG (the ICT-standard displacement proxy).
// Guard the [2] history so the boolean is never `na` (v6 errors on na in `and`).
bullFvg = not na(high[2]) and low > high[2]
bearFvg = not na(low[2])  and high < low[2]
fvgTopBull = low        // bull FVG spans [high[2], low]
fvgBotBull = high[2]
fvgTopBear = low[2]     // bear FVG spans [high, low[2]]
fvgBotBear = high

// 2b) Market-structure shift in the bias direction (close beyond the minor swing).
breakUp   = not na(lastSwingHigh) and (useCloseBreak ? close > lastSwingHigh : high > lastSwingHigh)
breakDown = not na(lastSwingLow)  and (useCloseBreak ? close < lastSwingLow  : low  < lastSwingLow)

// Sequential state machine (matches src/tradingbot/strategy/vp_ict_v1.py):
//   stage 0 idle  -> 1 swept -> 2 armed -> entry
// ICT is an ORDERED move (sweep first, THEN displacement/MSS+FVG, THEN retrace),
// not three conditions on one candle, so we walk the stages with timeouts.
var int   stage    = 0
var int   stageDir = 0     // +1 long, -1 short
var int   stageAge = 0
var float fvgTop   = na
var float fvgBot   = na
var float sweptExt = na
var box   fvgBox   = na

longEntry  = false
shortEntry = false
var float entryPrice = na
var float stopPrice  = na
var float tp1Price   = na
var float tp2Price   = na

stageAge += 1

// Stage 0 -> 1: a liquidity sweep in the bias direction starts the sequence.
if stage == 0 and setupActive
    if setupBias == 1 and sweptLow
        stage    := 1
        stageDir := 1
        stageAge := 0
        sweptExt := low
    else if setupBias == -1 and sweptHigh
        stage    := 1
        stageDir := -1
        stageAge := 0
        sweptExt := high

// Stage 1 -> 2: within sweepWindow, an MSS+FVG arms the entry zone.
else if stage == 1
    if stageAge > sweepWindow or stageDir != setupBias
        stage := 0
    else if stageDir == 1 and breakUp and bullFvg
        stage    := 2
        stageAge := 0
        fvgTop   := fvgTopBull
        fvgBot   := fvgBotBull
        if showFVG
            fvgBox := box.new(bar_index, fvgTop, bar_index + 5, fvgBot,
                 border_color=colLong, bgcolor=color.new(colLong, 85))
    else if stageDir == -1 and breakDown and bearFvg
        stage    := 2
        stageAge := 0
        fvgTop   := fvgTopBear
        fvgBot   := fvgBotBear
        if showFVG
            fvgBox := box.new(bar_index, fvgTop, bar_index + 5, fvgBot,
                 border_color=colShort, bgcolor=color.new(colShort, 85))

// Stage 2 -> entry: within entryWindow, a retrace into the FVG fires the trade.
else if stage == 2
    if stageAge > entryWindow
        stage := 0
    else if stageDir == 1
        fvgMid = fvgBot + (fvgTop - fvgBot) * oteMax   // 0.5 = consequent encroachment
        kzOk = not useKillzone or inKillzone
        pdOk = not useVwapPD or na(sessionVwap) or fvgMid <= sessionVwap   // discount
        if low <= fvgMid
            if kzOk and pdOk
                longEntry  := true
                entryPrice := fvgMid
                stopPrice  := sweptExt - atr * stopBuffAtr
                tp1Price   := na(poc) ? vah : poc      // target 1: fair value (POC)
                tp2Price   := vah                      // target 2: opposite VA edge
            stage := 0                                 // reached zone -> resolve setup
        else if not na(sweptExt) and close < sweptExt  // invalidated
            stage := 0
    else if stageDir == -1
        fvgMid = fvgTop - (fvgTop - fvgBot) * oteMax
        kzOk = not useKillzone or inKillzone
        pdOk = not useVwapPD or na(sessionVwap) or fvgMid >= sessionVwap   // premium
        if high >= fvgMid
            if kzOk and pdOk
                shortEntry := true
                entryPrice := fvgMid
                stopPrice  := sweptExt + atr * stopBuffAtr
                tp1Price   := na(poc) ? val : poc
                tp2Price   := val
            stage := 0
        else if not na(sweptExt) and close > sweptExt
            stage := 0

// Reset the sequence if the whole setup expired.
if not setupActive
    stage := 0

// ============================ DRAWING ========================================
// Profile lines + labels are (re)drawn on the last bar so historical bars stay
// clean and we respect Pine's object limits.
var line  pocLine = na
var line  vahLine = na
var line  valLine = na
var label pocLbl  = na
var label vahLbl  = na
var label valLbl  = na
var line  npocLine = na

f_setLevel(line ln, label lb, float price, color c, string txt) =>
    line  l = ln
    label b = lb
    if not na(price)
        if na(l)
            l := line.new(bar_index - 1, price, bar_index, price, color=c, width=2,
                 extend=extend.right)
            b := label.new(bar_index, price, txt + " " + str.tostring(price, format.mintick),
                 style=label.style_label_left, color=color.new(c, 80), textcolor=c, size=size.small)
        else
            line.set_xy1(l, bar_index - 1, price)
            line.set_xy2(l, bar_index, price)
            label.set_xy(b, bar_index, price)
            label.set_text(b, txt + " " + str.tostring(price, format.mintick))
    [l, b]

if barstate.islast
    [pl1, pb1] = f_setLevel(pocLine, pocLbl, poc, colPOC, "POC")
    pocLine := pl1
    pocLbl  := pb1
    [vl1, vb1] = f_setLevel(vahLine, vahLbl, vah, colVA, "VAH")
    vahLine := vl1
    vahLbl  := vb1
    [vl2, vb2] = f_setLevel(valLine, valLbl, val, colVA, "VAL")
    valLine := vl2
    valLbl  := vb2
    // naked POC as a dashed line
    if useNPOC and nakedActive and not na(nakedPoc)
        if na(npocLine)
            npocLine := line.new(bar_index - 1, nakedPoc, bar_index, nakedPoc,
                 color=color.new(colPOC, 30), style=line.style_dashed, width=1, extend=extend.right)
        else
            line.set_xy1(npocLine, bar_index - 1, nakedPoc)
            line.set_xy2(npocLine, bar_index, nakedPoc)
    else if not na(npocLine)
        line.delete(npocLine)
        npocLine := na

// Histogram (light, drawn on the last bar to the left of price).
var box[] histoBoxes = array.new_box()
if showHisto and barstate.islast and not na(profRowH) and array.size(bins) > 0
    for b in histoBoxes
        box.delete(b)
    array.clear(histoBoxes)
    maxV = 0.0
    for i = 0 to array.size(bins) - 1
        maxV := math.max(maxV, array.get(bins, i))
    if maxV > 0
        widthBars = 40
        for i = 0 to array.size(bins) - 1
            v = array.get(bins, i)
            w = int(widthBars * v / maxV)
            if w > 0
                top = profBot + (i + 1) * profRowH
                bot = profBot + i * profRowH
                bx = box.new(bar_index - w, top, bar_index, bot,
                     border_color=na, bgcolor=colHist)
                array.push(histoBoxes, bx)

// HVN / LVN markers (on the last bar, at the row price).
if showNodes and barstate.islast and not na(profRowH) and array.size(bins) >= 2 * nodeWin + 1
    for i = nodeWin to array.size(bins) - 1 - nodeWin
        v = array.get(bins, i)
        nb = 0.0
        for k = 1 to nodeWin
            nb += array.get(bins, i - k) + array.get(bins, i + k)
        avgN = nb / (2 * nodeWin)
        rowP = profBot + (i + 0.5) * profRowH
        isHVN = v >= avgN * hvnFactor
        isLVN = avgN > 0 and v <= avgN * lvnFactor
        if isHVN
            label.new(bar_index, rowP, "HVN", style=label.style_label_left,
                 color=color.new(color.green, 80), textcolor=color.green, size=size.tiny)
        else if isLVN
            label.new(bar_index, rowP, "LVN", style=label.style_label_left,
                 color=color.new(color.red, 80), textcolor=color.red, size=size.tiny)

// Session VWAP (equilibrium reference for the premium/discount gate).
plot(useVwapPD ? sessionVwap : na, title="Session VWAP",
     color=color.new(color.purple, 0), linewidth=1)

// Setup marker.
plotshape(newSetup and setupBias == 1,  title="Long setup",  style=shape.diamond,
     location=location.belowbar, color=colLong,  size=size.tiny)
plotshape(newSetup and setupBias == -1, title="Short setup", style=shape.diamond,
     location=location.abovebar, color=colShort, size=size.tiny)

// Entry markers (arrows). Text lives in the offset label so nothing overlaps.
plotshape(longEntry,  title="Long entry",  style=shape.triangleup,   location=location.belowbar,
     color=colLong,  size=size.small)
plotshape(shortEntry, title="Short entry", style=shape.triangledown, location=location.abovebar,
     color=colShort, size=size.small)

// Working target (bot exit) and the breakeven trigger price shown to the trader.
primaryTarget = targetMode == "POC" ? tp1Price : tp2Price
beLevel = entryPrice + (primaryTarget - entryPrice) * breakevenAt
beTxt = breakevenAt > 0 ? "\nBE @" + str.tostring(beLevel, format.mintick) : ""

// The label is pushed `lblOffset` bars to the right (and a faint connector line
// is drawn back to the entry bar) so it never sits on top of the FVG box/arrow.
if longEntry
    txt = "LONG @ " + str.tostring(entryPrice, format.mintick) +
         "\nSL " + str.tostring(stopPrice, format.mintick) +
         "\nTP " + str.tostring(tp1Price, format.mintick) + " / " + str.tostring(tp2Price, format.mintick) + beTxt
    label.new(bar_index + lblOffset, entryPrice, txt, xloc=xloc.bar_index,
         style=label.style_label_left, color=color.new(colLong, 10), textcolor=color.white, size=lblSize)
    line.new(bar_index, entryPrice, bar_index + lblOffset, entryPrice, color=color.new(colLong, 40), style=line.style_dotted)
if shortEntry
    txt = "SHORT @ " + str.tostring(entryPrice, format.mintick) +
         "\nSL " + str.tostring(stopPrice, format.mintick) +
         "\nTP " + str.tostring(tp1Price, format.mintick) + " / " + str.tostring(tp2Price, format.mintick) + beTxt
    label.new(bar_index + lblOffset, entryPrice, txt, xloc=xloc.bar_index,
         style=label.style_label_left, color=color.new(colShort, 10), textcolor=color.white, size=lblSize)
    line.new(bar_index, entryPrice, bar_index + lblOffset, entryPrice, color=color.new(colShort, 40), style=line.style_dotted)

// ===================== TRADE RESULT (1 micro contract) ======================
// Track one open position from entry to its SL/TP, colour the exit candle and
// print the $ result for 1 contract. Mirrors the backtest: stop checked before
// target (conservative), optional breakeven move, exit at the chosen target.
var int    posDir    = 0          // 0 flat, +1 long, -1 short
var float  posEntry  = na
var float  posStop   = na
var float  posTarget = na
var float  posBE     = na
var bool   posBEon   = false
var float  cumPnl    = 0.0
var int    nWins     = 0
var int    nTrades   = 0

exitWin  = false
exitLoss = false
exitBE   = false
float tradePnl = na

// Manage an already-open position FIRST (so it can't exit on its own entry bar).
if posDir != 0
    if breakevenAt > 0 and not posBEon and ((posDir == 1 and high >= posBE) or (posDir == -1 and low <= posBE))
        posStop := posEntry
        posBEon := true
    if posDir == 1
        if low <= posStop
            tradePnl := (posStop - posEntry) * pointValue
            posDir   := 0
        else if high >= posTarget
            tradePnl := (posTarget - posEntry) * pointValue
            posDir   := 0
    else
        if high >= posStop
            tradePnl := (posStop - posEntry) * pointValue * -1
            posDir   := 0
        else if low <= posTarget
            tradePnl := (posEntry - posTarget) * pointValue
            posDir   := 0
    if not na(tradePnl)
        cumPnl  += tradePnl
        nTrades += 1
        exitWin  := tradePnl > 0
        exitLoss := tradePnl < 0
        exitBE   := tradePnl == 0
        nWins := nWins + (exitWin ? 1 : 0)

// Open a new position when an entry fires and we are flat.
if posDir == 0 and (longEntry or shortEntry)
    posDir    := longEntry ? 1 : -1
    posEntry  := entryPrice
    posStop   := stopPrice
    posTarget := primaryTarget
    posBE     := beLevel
    posBEon   := false

// Colour the exit candle and label the $ result.
barcolor(showResult and exitWin ? color.lime : showResult and exitLoss ? color.red : showResult and exitBE ? color.gray : na, title="Exit candle")
if showResult and not na(tradePnl)
    resTxt = (tradePnl >= 0 ? "+$" : "-$") + str.tostring(math.abs(tradePnl), "#.##")
    label.new(bar_index, exitWin ? high : low, resTxt,
         style=exitWin ? label.style_label_down : label.style_label_up,
         color=exitWin ? color.new(color.green, 20) : exitLoss ? color.new(color.red, 20) : color.new(color.gray, 20),
         textcolor=color.white, size=lblSize)

// Running totals (top-right table).
var table pnlTable = table.new(position.top_right, 1, 3, border_width=1)
if showResult and barstate.islast
    winPct = nTrades > 0 ? 100.0 * nWins / nTrades : 0.0
    table.cell(pnlTable, 0, 0, "Total P&L: " + (cumPnl >= 0 ? "+$" : "-$") + str.tostring(math.abs(cumPnl), "#.##"),
         text_color=color.white, bgcolor=cumPnl >= 0 ? color.new(color.green, 20) : color.new(color.red, 20), text_size=size.normal)
    table.cell(pnlTable, 0, 1, "Trades: " + str.tostring(nTrades), text_color=color.white, bgcolor=color.new(color.gray, 20))
    table.cell(pnlTable, 0, 2, "Win rate: " + str.tostring(winPct, "#.#") + "%", text_color=color.white, bgcolor=color.new(color.gray, 20))

// ============================ ALERTS =========================================
alertcondition(newSetup,   title="VP setup formed", message="VP+ICT V1: Volume-Profile SETUP formed")
alertcondition(longEntry,  title="Long entry",      message="VP+ICT V1: LONG entry (sweep+MSS+FVG at VP level)")
alertcondition(shortEntry, title="Short entry",     message="VP+ICT V1: SHORT entry (sweep+MSS+FVG at VP level)")

// Single combined alert() for the Phase 2 webhook (JSON payload).
if longEntry or shortEntry
    side = longEntry ? "buy" : "sell"
    alert('{"strategy":"vp_ict_v1","action":"' + side +
         '","price":' + str.tostring(close) +
         ',"stop":' + str.tostring(stopPrice) +
         ',"tp1":' + str.tostring(tp1Price) +
         ',"tp2":' + str.tostring(tp2Price) +
         ',"setup":"' + setupName + '"}', alert.freq_once_per_bar_close)
